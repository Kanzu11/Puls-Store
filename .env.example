# PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@hostname/dbname?sslmode=require"

# Backend Server & JWT Auth
PORT=5000
JWT_SECRET="replace_with_strong_random_jwt_secret"

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
ADMIN_TELEGRAM_CHAT_ID="your_admin_telegram_chat_id"
TGCLOUD_API_KEY="your_tgcloud_api_key"
NEXT_PUBLIC_TMA_URL="https://your-mini-app.tgcloud.ai/"

# SMTP Transactional Email Service
EMAIL_SERVICE="gmail"
EMAIL_USER="your_email@example.com"
EMAIL_PASS="your_smtp_app_password"
